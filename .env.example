# Foresight-X environment variables template
# Copy this to .env and fill in your values
# Never commit .env to git

# === LLM APIs ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic

# === Supabase ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# === Upstash Redis ===
REDIS_URL=

# === Foresight-X app config ===
FORESIGHT_DATA_DIR=./data
FORESIGHT_USER_ID=local-dev
CHROMA_PERSIST_DIR=./chroma_data

# === Voice / Slime (push-to-talk) ===
# Default ASR is local faster-whisper (CPU/RAM heavy). Docker image installs ffmpeg for WebM decode.
# On small Railway instances prefer cloud ASR:
# ASR_PROVIDER=openai
# (requires OPENAI_API_KEY; same key as chat)
# FASTER_WHISPER_MODEL=small

# === Backend deployment ===
# Must include every browser origin that calls this API (comma-separated, no spaces).
# Split deploy (Vercel + Railway): include production + local dev, e.g.
# ALLOWED_ORIGINS=https://foresight-x.vercel.app,http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: regex for Vercel previews, e.g. ^https://foresight-x-[a-z0-9]+-yourteam\\.vercel\\.app$
CORS_PREVIEW_REGEX=
ENVIRONMENT=local
SENTRY_DSN_BACKEND=

# === Frontend (see web/.env.example) ===
# Local: usually unset → Vite proxies /api to this backend.
# Split deploy: set on Vercel — VITE_API_ORIGIN=https://your-api.example.com
