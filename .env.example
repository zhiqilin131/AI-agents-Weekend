# Foresight-X environment variables template
# Copy this to .env and fill in your values
# Never commit .env to git

# === LLM APIs ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Slime tiers (override per row; empty string disables that row). Defaults: little=gpt-4o-mini, swift=gpt-4.1-nano, balanced=gpt-4.1-mini, deep=gpt-4.1.
# OPENAI_MODEL_LITTLE=gpt-4o-mini
# OPENAI_MODEL_SWIFT=gpt-4.1-nano
# OPENAI_MODEL_BALANCED=gpt-4.1-mini
# OPENAI_MODEL_DEEP=gpt-4.1
# OPENAI_MODEL_SLIME_55=gpt-4.1
# OPENAI_MODEL_RESEARCH=
# MODEL_SLIME_55_MULTIPLIER=15
# GPT-5 family uses Responses API — tuning (see foresight_x/orchestration/llm_factory.py):
# OPENAI_RESPONSES_REASONING_EFFORT=low
# OPENAI_RESPONSES_MAX_OUTPUT_TOKENS=16384
# OPENAI_RESPONSES_CONTEXT_WINDOW=1048576
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# When false, memory rows tagged "other" use rule-only re-bucketing (no extra LLM call).
# MEMORY_FACT_CATEGORY_LLM_REFINE=true
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic

# === Supabase ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# When SUPABASE_URL is set, REQUIRE_AUTH is forced to true unless you opt into unsafe shared persona:
# ALLOW_PERSONA_FALLBACK_WITH_SUPABASE=true
# (That lets unauthenticated /api use one on-disk persona for all users — not for production.)
REQUIRE_AUTH=false
# ALLOW_PERSONA_FALLBACK_WITH_SUPABASE=false

# === Upstash Redis ===
REDIS_URL=

# === Foresight-X app config ===
# Local: ./data is fine. Docker/Railway: set FORESIGHT_DATA_DIR=/data and mount a persistent volume at /data
# (see README «Deployment persistence»). Otherwise redeploys wipe profile, chat threads, and all on-disk memory.
FORESIGHT_DATA_DIR=./data
FORESIGHT_USER_ID=local-dev
# Keep Chroma under the same tree in production, e.g. CHROMA_PERSIST_DIR=/data/chroma with FORESIGHT_DATA_DIR=/data
CHROMA_PERSIST_DIR=./chroma_data

# === Voice / Slime (push-to-talk) ===
# Default ASR is local faster-whisper (CPU/RAM heavy). Docker image installs ffmpeg for WebM decode.
# On small Railway instances prefer cloud ASR:
# ASR_PROVIDER=openai
# (requires OPENAI_API_KEY; same key as chat)
# FASTER_WHISPER_MODEL=small
# Server TTS for Slime Buddy auto-play. Paid OpenAI call; browser speechSynthesis remains the fallback.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_INSTRUCTIONS=Speak like a tiny friendly slime companion: warm, cute, lightly bouncy, curious, and emotionally expressive, but still clear and not childish.

# === Backend deployment ===
# Must include every browser origin that calls this API (comma-separated, no spaces).
# Split deploy (Vercel + Railway): include production + local dev, e.g.
# ALLOWED_ORIGINS=https://foresight-x.vercel.app,http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: regex for Vercel previews, e.g. ^https://foresight-x-[a-z0-9]+-yourteam\\.vercel\\.app$
CORS_PREVIEW_REGEX=
ENVIRONMENT=local
SENTRY_DSN_BACKEND=

# === Slime Credits (usage limits) ===
# ENABLE_CREDIT_LIMITS=false disables blocking (still creates balances / optional logs).
ENABLE_CREDIT_LIMITS=true
DEFAULT_SLIME_CREDITS=15
TEST_CODE_REWARD_CREDITS=100
# Testing code: same phrase can be redeemed repeatedly (each time grants TEST_CODE_REWARD_CREDITS).
SLIME_TEST_CODE=
# Comma-separated Supabase user ids and/or emails with unlimited AI (backend-enforced).
ENABLE_ADMIN_UNLIMITED=true
ADMIN_USER_IDS=
ADMIN_EMAILS=
ADMIN_LOCAL_USER_IDS=
ADMIN_UNLIMITED_USER_IDS=
SLIME_VOUCHER_ENABLED=true
SLIME_VOUCHER_CODE=foresight-beta
SLIME_VOUCHER_REWARD_CREDITS=15
SLIME_VOUCHER_MAX_REDEMPTIONS_PER_USER=1
# Optional per-feature overrides (non-negative integers):
# CREDIT_COST_SHADOW_CHAT=1
# CREDIT_COST_DECISION_REPORT=5
# CREDIT_COST_DIARY_GENERATE=2
# CREDIT_COST_MEMORY_IMPORT=3
# CREDIT_COST_CALENDAR_AGENT=1
# CREDIT_COST_RESOURCE_SEARCH=1
# CREDIT_COST_TTS=1
# CREDIT_COST_ASR=0

# === Frontend (see web/.env.example) ===
# Local: usually unset → Vite proxies /api to this backend.
# Split deploy: set on Vercel — VITE_API_ORIGIN=https://your-api.example.com
