# Backend for API + streaming (see apiOrigin.ts)
# VITE_API_ORIGIN=http://127.0.0.1:8765
#
# Production (Vercel): REQUIRED — set to your Railway API origin, no trailing slash.
# Without it, /api calls hit Vercel (404), Slime Credits never load, redeem always fails.
# Example: VITE_API_ORIGIN=https://your-service.up.railway.app

# Supabase Auth (optional for local dev). When BOTH URL and anon key are set, the app requires
# sign-in for all pages except /login and /register.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key

# WebGL slime (R3F). Local dev: set 1 in web/.env.development.
# Production builds default to 3D when unset; set 0 to force SVG fallback (CI).
# VITE_SLIME_3D=1
# VITE_SLIME_3D=0
